{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "CoinGecko": {
    "RequestsPerMinute": 20
  },
  "HistoricalData": {
    "DatabasePath": "Data/market-history.db"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:5174"]
  },
  "HttpsRedirection": {
    "HttpsPort": 443
  },
  "AllowedHosts": "*"
}
